+// Downstream UniFFI exposure only: delegate transport encoding to mls-rs.
+#[uniffi::export]
+impl Message {
+    #[uniffi::constructor]
+    pub fn from_bytes(bytes: Vec<u8>) -> Result<Self, Error> {
+        Ok(Self {
+            inner: mls_rs::MlsMessage::from_bytes(&bytes)?,
+        })
+    }
+
+    pub fn to_bytes(&self) -> Result<Vec<u8>, Error> {
+        Ok(self.inner.to_bytes()?)
+    }
+}
