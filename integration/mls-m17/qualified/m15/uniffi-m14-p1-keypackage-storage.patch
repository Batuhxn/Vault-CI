diff --git a/mls-rs-uniffi/src/config/key_package_storage.rs b/mls-rs-uniffi/src/config/key_package_storage.rs
new file mode 100644
index 0000000..3ab612b
--- /dev/null
+++ b/mls-rs-uniffi/src/config/key_package_storage.rs
@@ -0,0 +1,118 @@
+use mls_rs::error::IntoAnyError;
+use mls_rs_core::mls_rs_codec::{MlsDecode, MlsEncode};
+use std::fmt::Debug;
+use std::sync::Arc;
+#[cfg(not(mls_build_async))]
+use std::sync::Mutex;
+#[cfg(mls_build_async)]
+use tokio::sync::Mutex;
+
+use crate::Error;
+
+/// Foreign storage for upstream `KeyPackageData`, passed as opaque bytes in
+/// the upstream MLS codec encoding. See [`mls_rs_core::key_package::KeyPackageStorage`].
+// Attribute order: see `GroupStateStorage`.
+#[cfg_attr(mls_build_async, uniffi::export(with_foreign))]
+#[cfg_attr(mls_build_async, maybe_async::must_be_async)]
+#[cfg_attr(not(mls_build_async), maybe_async::must_be_sync)]
+#[cfg_attr(not(mls_build_async), uniffi::export(with_foreign))]
+pub trait KeyPackageStorage: Send + Sync + Debug {
+    // Uniffi doesn't support zeroizing
+    async fn delete(&self, id: Vec<u8>) -> Result<(), Error>;
+    async fn insert(&self, id: Vec<u8>, data: Vec<u8>) -> Result<(), Error>;
+    async fn get(&self, id: Vec<u8>) -> Result<Option<Vec<u8>>, Error>;
+}
+
+/// Adapt a mls-rs `KeyPackageStorage` implementation to [`KeyPackageStorage`].
+#[derive(Debug)]
+pub(crate) struct KeyPackageStorageAdapter<S>(Mutex<S>);
+
+impl<S> KeyPackageStorageAdapter<S> {
+    pub fn new(key_package_storage: S) -> KeyPackageStorageAdapter<S> {
+        Self(Mutex::new(key_package_storage))
+    }
+
+    #[cfg(not(mls_build_async))]
+    fn inner(&self) -> std::sync::MutexGuard<'_, S> {
+        self.0.lock().unwrap()
+    }
+
+    #[cfg(mls_build_async)]
+    async fn inner(&self) -> tokio::sync::MutexGuard<'_, S> {
+        self.0.lock().await
+    }
+}
+
+#[cfg_attr(not(mls_build_async), maybe_async::must_be_sync)]
+#[cfg_attr(mls_build_async, maybe_async::must_be_async)]
+impl<S, Err> KeyPackageStorage for KeyPackageStorageAdapter<S>
+where
+    S: mls_rs::KeyPackageStorage<Error = Err> + Debug,
+    Err: IntoAnyError,
+{
+    async fn delete(&self, id: Vec<u8>) -> Result<(), Error> {
+        self.inner()
+            .await
+            .delete(&id)
+            .await
+            .map_err(|err| err.into_any_error().into())
+    }
+
+    async fn insert(&self, id: Vec<u8>, data: Vec<u8>) -> Result<(), Error> {
+        let data = mls_rs_core::key_package::KeyPackageData::mls_decode(&mut &*data)
+            .map_err(|err| err.into_any_error())?;
+        self.inner()
+            .await
+            .insert(id, data)
+            .await
+            .map_err(|err| err.into_any_error().into())
+    }
+
+    async fn get(&self, id: Vec<u8>) -> Result<Option<Vec<u8>>, Error> {
+        let data = self
+            .inner()
+            .await
+            .get(&id)
+            .await
+            .map_err(|err| err.into_any_error())?;
+        data.map(|data| data.mls_encode_to_vec())
+            .transpose()
+            .map_err(|err| err.into_any_error().into())
+    }
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct ClientKeyPackageStorage(pub(crate) Arc<dyn KeyPackageStorage>);
+
+#[cfg_attr(not(mls_build_async), maybe_async::must_be_sync)]
+#[cfg_attr(mls_build_async, maybe_async::must_be_async)]
+impl mls_rs_core::key_package::KeyPackageStorage for ClientKeyPackageStorage {
+    type Error = Error;
+
+    async fn delete(&mut self, id: &[u8]) -> Result<(), Self::Error> {
+        self.0.delete(id.to_vec()).await
+    }
+
+    async fn insert(
+        &mut self,
+        id: Vec<u8>,
+        pkg: mls_rs_core::key_package::KeyPackageData,
+    ) -> Result<(), Self::Error> {
+        let data = pkg
+            .mls_encode_to_vec()
+            .map_err(|err| err.into_any_error())?;
+        self.0.insert(id, data).await
+    }
+
+    async fn get(
+        &self,
+        id: &[u8],
+    ) -> Result<Option<mls_rs_core::key_package::KeyPackageData>, Self::Error> {
+        self.0
+            .get(id.to_vec())
+            .await?
+            .map(|data| mls_rs_core::key_package::KeyPackageData::mls_decode(&mut &*data))
+            .transpose()
+            .map_err(|err| err.into_any_error().into())
+    }
+}
